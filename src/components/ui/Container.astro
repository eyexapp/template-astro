---
import { cn } from '@lib/utils';

interface Props {
  size?: 'sm' | 'md' | 'lg' | 'xl' | 'full';
  class?: string;
}

const { size = 'lg', class: className } = Astro.props;

const sizes = {
  sm: 'max-w-3xl',
  md: 'max-w-5xl',
  lg: 'max-w-7xl',
  xl: 'max-w-screen-2xl',
  full: 'max-w-full',
};
---

<div class={cn('mx-auto w-full px-4 sm:px-6 lg:px-8', sizes[size], className)}>
  <slot />
</div>
