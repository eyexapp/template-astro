---
import { cn } from '@lib/utils';
import Container from './Container.astro';

interface Props {
  id?: string;
  class?: string;
  containerSize?: 'sm' | 'md' | 'lg' | 'xl';
  background?: 'default' | 'alt' | 'primary';
}

const { id, class: className, containerSize = 'lg', background = 'default' } = Astro.props;

const backgrounds = {
  default: '',
  alt: 'bg-[var(--color-surface-alt)] dark:bg-[var(--color-surface-alt-dark)]',
  primary: 'bg-[var(--color-primary-50)] dark:bg-[var(--color-primary-900)]/20',
};
---

<section id={id} class={cn('py-16 sm:py-20', backgrounds[background], className)}>
  <Container size={containerSize}>
    <slot />
  </Container>
</section>
