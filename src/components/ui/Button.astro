---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '@lib/utils';

interface Props extends HTMLAttributes<'button'> {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  class: className,
  ...attrs
} = Astro.props;

const baseStyles = 'inline-flex items-center justify-center font-medium rounded-lg transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[var(--color-primary-500)]';

const variants = {
  primary: 'bg-[var(--color-primary-600)] text-white hover:bg-[var(--color-primary-700)] shadow-sm',
  secondary: 'bg-[var(--color-surface-alt)] text-[var(--color-text)] hover:bg-[var(--color-border)] dark:bg-[var(--color-surface-alt-dark)] dark:text-[var(--color-text-dark)] dark:hover:bg-[var(--color-border-dark)]',
  outline: 'border border-[var(--color-border)] text-[var(--color-text)] hover:bg-[var(--color-surface-alt)] dark:border-[var(--color-border-dark)] dark:text-[var(--color-text-dark)] dark:hover:bg-[var(--color-surface-alt-dark)]',
  ghost: 'text-[var(--color-text-light)] hover:bg-[var(--color-surface-alt)] hover:text-[var(--color-text)] dark:text-[var(--color-text-light-dark)] dark:hover:bg-[var(--color-surface-alt-dark)]',
};

const sizes = {
  sm: 'text-sm px-3 py-1.5 gap-1.5',
  md: 'text-sm px-4 py-2.5 gap-2',
  lg: 'text-base px-6 py-3 gap-2',
};

const classes = cn(baseStyles, variants[variant], sizes[size], className);
---

{href ? (
  <a href={href} class={classes} {...attrs}>
    <slot />
  </a>
) : (
  <button class={classes} {...attrs}>
    <slot />
  </button>
)}
