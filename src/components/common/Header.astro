---
import { siteConfig } from '@core/config/site.config';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLocaleFromUrl, useTranslations } from '@i18n/index';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<header class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[var(--color-surface)]/80 backdrop-blur-lg dark:border-[var(--color-border-dark)] dark:bg-[var(--color-surface-dark)]/80">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 text-lg font-bold tracking-tight">
      <svg class="h-7 w-7 text-[var(--color-primary-600)]" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M18 2L33 28H3L18 2Z" fill="currentColor" opacity="0.8"/>
        <path d="M18 10L27 28H9L18 10Z" fill="currentColor"/>
      </svg>
      <span>{siteConfig.name}</span>
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden items-center gap-1 md:flex">
      {siteConfig.nav.main.map((item) => (
        <a
          href={item.href}
          class:list={[
            'rounded-md px-3 py-2 text-sm font-medium transition-colors',
            Astro.url.pathname === item.href || (item.href !== '/' && Astro.url.pathname.startsWith(item.href))
              ? 'bg-[var(--color-primary-50)] text-[var(--color-primary-700)] dark:bg-[var(--color-primary-900)] dark:text-[var(--color-primary-300)]'
              : 'text-[var(--color-text-light)] hover:bg-[var(--color-surface-alt)] hover:text-[var(--color-text)] dark:text-[var(--color-text-light-dark)] dark:hover:bg-[var(--color-surface-alt-dark)]',
          ]}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
        >
          {t(`nav.${item.label.toLowerCase()}` as any) || item.label}
        </a>
      ))}
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-2">
      <LanguageSwitcher />
      <ThemeToggle />

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="inline-flex items-center justify-center rounded-md p-2 text-[var(--color-muted)] hover:bg-[var(--color-surface-alt)] md:hidden"
        aria-label="Toggle menu"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Navigation -->
  <div id="mobile-menu" class="hidden border-t border-[var(--color-border)] md:hidden dark:border-[var(--color-border-dark)]">
    <div class="space-y-1 px-4 py-3">
      {siteConfig.nav.main.map((item) => (
        <a
          href={item.href}
          class:list={[
            'block rounded-md px-3 py-2 text-base font-medium transition-colors',
            Astro.url.pathname === item.href
              ? 'bg-[var(--color-primary-50)] text-[var(--color-primary-700)]'
              : 'text-[var(--color-text-light)] hover:bg-[var(--color-surface-alt)]',
          ]}
        >
          {t(`nav.${item.label.toLowerCase()}` as any) || item.label}
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
