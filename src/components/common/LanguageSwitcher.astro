---
import { siteConfig } from '@core/config/site.config';
import { getLocaleFromUrl } from '@i18n/index';

const currentLocale = getLocaleFromUrl(Astro.url);
const otherLocales = siteConfig.locales.filter((l) => l !== currentLocale);
---

<div class="relative">
  <button
    id="lang-toggle"
    class="inline-flex items-center gap-1 rounded-md px-2 py-1.5 text-sm font-medium text-[var(--color-muted)] hover:bg-[var(--color-surface-alt)] hover:text-[var(--color-text)] transition-colors dark:text-[var(--color-muted-dark)] dark:hover:bg-[var(--color-surface-alt-dark)] dark:hover:text-[var(--color-text-dark)]"
    aria-label="Switch language"
  >
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
    </svg>
    <span class="uppercase">{currentLocale}</span>
  </button>

  <div
    id="lang-dropdown"
    class="absolute right-0 top-full z-50 mt-1 hidden min-w-[6rem] rounded-md border border-[var(--color-border)] bg-[var(--color-surface)] py-1 shadow-lg dark:border-[var(--color-border-dark)] dark:bg-[var(--color-surface-dark)]"
  >
    <a
      href={Astro.url.pathname}
      class="flex items-center gap-2 px-3 py-1.5 text-sm font-medium text-[var(--color-primary-600)]"
    >
      <span class="uppercase">{currentLocale}</span>
      <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
    </a>
    {otherLocales.map((locale) => {
      const targetPath = currentLocale === 'en'
        ? `/${locale}${Astro.url.pathname}`
        : Astro.url.pathname.replace(`/${currentLocale}`, locale === 'en' ? '' : `/${locale}`) || '/';
      return (
        <a
          href={targetPath}
          class="block px-3 py-1.5 text-sm text-[var(--color-text-light)] hover:bg-[var(--color-surface-alt)] dark:text-[var(--color-text-light-dark)] dark:hover:bg-[var(--color-surface-alt-dark)]"
        >
          <span class="uppercase">{locale}</span>
        </a>
      );
    })}
  </div>
</div>

<script>
  const btn = document.getElementById('lang-toggle');
  const dropdown = document.getElementById('lang-dropdown');

  btn?.addEventListener('click', (e) => {
    e.stopPropagation();
    dropdown?.classList.toggle('hidden');
  });

  document.addEventListener('click', () => {
    dropdown?.classList.add('hidden');
  });
</script>
