---
// ThemeToggle — pure Astro component, hydrated via inline script
---

<button
  id="theme-toggle"
  class="inline-flex items-center justify-center rounded-md p-2 text-[var(--color-muted)] hover:bg-[var(--color-surface-alt)] hover:text-[var(--color-text)] transition-colors dark:text-[var(--color-muted-dark)] dark:hover:bg-[var(--color-surface-alt-dark)] dark:hover:text-[var(--color-text-dark)]"
  aria-label="Toggle theme"
>
  <!-- Sun icon (shown in dark mode) -->
  <svg class="h-5 w-5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
  </svg>
  <!-- Moon icon (shown in light mode) -->
  <svg class="h-5 w-5 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
  </svg>
</button>

<script>
  import { toggleTheme } from '@stores/theme.store';

  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
</script>
