---
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/ui/Button.astro';
import { getLocaleFromUrl, useTranslations } from '@i18n/index';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<BaseLayout seo={{ title: '404', noindex: true }}>
  <div class="flex min-h-[60vh] flex-col items-center justify-center px-4 text-center">
    <p class="text-6xl font-bold text-[var(--color-primary-600)]">404</p>
    <h1 class="mt-4 text-2xl font-bold tracking-tight sm:text-3xl">
      {t('common.pageNotFound')}
    </h1>
    <p class="mt-4 text-[var(--color-text-light)] dark:text-[var(--color-text-light-dark)] max-w-md">
      {t('common.pageNotFoundDesc')}
    </p>
    <div class="mt-8">
      <Button variant="primary" href="/">
        {t('common.backToHome')}
      </Button>
    </div>
  </div>
</BaseLayout>
