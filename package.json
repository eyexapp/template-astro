{
  "name": "astro-master-template",
  "type": "module",
  "version": "1.0.0",
  "description": "Production-ready Astro master template with multi-framework Islands Architecture, Content Collections, i18n, Nano Stores, and Tailwind design system",
  "keywords": [
    "astro",
    "template",
    "islands-architecture",
    "multi-framework",
    "tailwind",
    "i18n",
    "content-collections"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . --report-unused-disable-directives",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "[ -d .git ] && husky || true",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/preact": "^4.1.3",
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.7.1",
    "@astrojs/solid-js": "^5.1.3",
    "@astrojs/svelte": "^7.2.5",
    "@astrojs/vue": "^5.1.4",
    "@nanostores/preact": "^1.0.0",
    "@nanostores/react": "^1.0.0",
    "@nanostores/solid": "^1.1.1",
    "@nanostores/vue": "^1.1.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "astro": "^5.17.1",
    "clsx": "^2.1.1",
    "nanostores": "^1.1.1",
    "preact": "^10.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "solid-js": "^1.9.10",
    "svelte": "^5.46.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "vue": "^3.5.26"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.7",
    "@commitlint/cli": "^20.4.4",
    "@commitlint/config-conventional": "^20.4.4",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^10.0.3",
    "eslint-plugin-astro": "^1.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.astro": [
      "prettier --write --plugin=prettier-plugin-astro"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
